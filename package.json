{
  "name": "suishi-solar-terms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "check:dist": "node scripts/check-dist.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "test:e2e": "playwright test",
    "art:review": "node scripts/contact-sheet.mjs",
    "build:release": "vite build --mode release && node scripts/check-release.mjs",
    "build:all": "npm run build && npm run build:release",
    "preview:release": "vite preview --mode release --host 127.0.0.1",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.10",
    "sharp": "^0.34.0",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
